# Copy to .env and fill in. .env is gitignored; never commit real values.

# PostgreSQL
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me

# Host ports
DB_PORT=5432
API_PORT=8080
FRONTEND_PORT=4200

# ---------------------------------------------------------------------------
# Azure: ALL OPTIONAL. Leave them empty and everything runs locally
# (files on a docker volume, logs on the console). Real values only in .env.
# ---------------------------------------------------------------------------

# Application Insights (logs, requests, PostgreSQL calls; CorrelationId as a field)
# Portal: Application Insights resource > Overview > Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Document Intelligence (bonus PDF extraction; empty = feature off)
# Portal: Document Intelligence resource > Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Blob Storage for uploaded files. Default Local = docker volume.
# AzureBlob connects by account URL + Entra ID (DefaultAzureCredential: Managed Identity in Azure,
# `az login` on a developer machine; needs the "Storage Blob Data Contributor" role), or by a
# connection string with an account key (Azurite, or accounts that allow keys).
# Note: inside docker on a laptop there is no Entra ID login, so keep Local there.
STORAGE_PROVIDER=Local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
